<Window x:Class="BatterieInBarra.ImpostazioniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batterie in Barra - Impostazioni"
        Width="560" Height="740"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Sfondo}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <!-- Titolo di una sezione (DISPOSITIVI, BARRA...) -->
        <Style x:Key="TitoloSezione" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TestoGrigio}" />
            <Setter Property="Margin" Value="4,16,4,8" />
        </Style>

        <!-- Il riquadro arrotondato che contiene le righe -->
        <Style x:Key="Riquadro" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SfondoRiquadro}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,2,14,2" />
        </Style>

        <Style x:Key="TitoloRiga" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Testo}" />
        </Style>

        <Style x:Key="SottoRiga" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TestoGrigio}" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style x:Key="Separatore" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Linea}" />
        </Style>

        <!-- Interruttore: una casella di spunta con l'aspetto da interruttore -->
        <Style x:Key="Interruttore" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Binario" Width="38" Height="22" CornerRadius="11" Background="#8E8E93">
                            <Ellipse x:Name="Pallino" Width="18" Height="18" Fill="White"
                                     HorizontalAlignment="Left" Margin="2,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Binario" Property="Background" Value="#34C759" />
                                <Setter TargetName="Pallino" Property="Margin" Value="18,0,0,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scelta 10% / 20% / 30% -->
        <Style x:Key="Scelta" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TestoGrigio}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Sfondo" CornerRadius="6" Padding="14,4,14,5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Sfondo" Property="Background" Value="{DynamicResource Scelto}" />
                                <Setter Property="Foreground" Value="{DynamicResource Testo}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,6,22,22">

            <!-- Dispositivi: nome e "sulla barra" (le righe le crea il codice) -->
            <TextBlock Style="{StaticResource TitoloSezione}" Text="DISPOSITIVI" />
            <Border Style="{StaticResource Riquadro}">
                <StackPanel x:Name="ListaDispositivi" />
            </Border>

            <!-- Barra -->
            <TextBlock Style="{StaticResource TitoloSezione}" Text="BARRA" />
            <Border Style="{StaticResource Riquadro}">
                <StackPanel>
                    <Grid Margin="0,11,0,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource TitoloRiga}" Text="Mostra la percentuale" />
                            <TextBlock Style="{StaticResource SottoRiga}" Text="Se è spenta vedi solo la batteria: la % compare col mouse" />
                        </StackPanel>
                        <CheckBox x:Name="MostraPercentuale" Grid.Column="1" Style="{StaticResource Interruttore}" Click="QuandoCambiaInterruttore" />
                    </Grid>
                    <Border Style="{StaticResource Separatore}" />
                    <Grid Margin="0,11,0,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource TitoloRiga}" Text="Animazioni" />
                            <TextBlock Style="{StaticResource SottoRiga}" Text="Dissolvenza quando un dispositivo si collega o si scollega" />
                        </StackPanel>
                        <CheckBox x:Name="Animazioni" Grid.Column="1" Style="{StaticResource Interruttore}" Click="QuandoCambiaInterruttore" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Avvisi -->
            <TextBlock Style="{StaticResource TitoloSezione}" Text="AVVISI" />
            <Border Style="{StaticResource Riquadro}">
                <StackPanel>
                    <Grid Margin="0,11,0,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource TitoloRiga}" Text="Batteria scarica sotto il" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="{DynamicResource SfondoCampo}" CornerRadius="8" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Soglia10" GroupName="Soglia" Style="{StaticResource Scelta}" Content="10%" Click="QuandoCambiaSoglia" />
                                <RadioButton x:Name="Soglia20" GroupName="Soglia" Style="{StaticResource Scelta}" Content="20%" Click="QuandoCambiaSoglia" />
                                <RadioButton x:Name="Soglia30" GroupName="Soglia" Style="{StaticResource Scelta}" Content="30%" Click="QuandoCambiaSoglia" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource Separatore}" />
                    <Grid Margin="0,11,0,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource TitoloRiga}" Text="Avvisa quando la carica è completa" />
                            <TextBlock Style="{StaticResource SottoRiga}" Text="Notifica quando un dispositivo torna al 100%" />
                        </StackPanel>
                        <CheckBox x:Name="AvvisoCompleta" Grid.Column="1" Style="{StaticResource Interruttore}" Click="QuandoCambiaInterruttore" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Generale -->
            <TextBlock Style="{StaticResource TitoloSezione}" Text="GENERALE" />
            <Border Style="{StaticResource Riquadro}">
                <Grid Margin="0,11,0,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource TitoloRiga}" Text="Avvia con Windows" />
                        <TextBlock Style="{StaticResource SottoRiga}" Text="Parte da sola quando accendi il PC" />
                    </StackPanel>
                    <CheckBox x:Name="AvvioWindows" Grid.Column="1" Style="{StaticResource Interruttore}" Click="QuandoCambiaInterruttore" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
