<Window x:Class="BatterieInBarra.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batterie"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <!-- La scheda con gli angoli arrotondati -->
    <Border x:Name="Scheda" Margin="10" CornerRadius="22" BorderThickness="1" Padding="20,18,20,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" />
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="Titolo" Text="Batterie" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14" />

            <!-- I cerchi in alto -->
            <UniformGrid x:Name="Cerchi" Rows="1" />

            <Border x:Name="Linea1" Height="1" Margin="0,16,0,6" />

            <!-- La lista con nome, tempo stimato, percentuale e mini batteria -->
            <StackPanel x:Name="Lista" />

            <!-- Messaggio se non c'è nessun dispositivo -->
            <TextBlock x:Name="Vuoto" Text="Nessun dispositivo collegato." FontSize="13" Margin="0,8,0,0" Visibility="Collapsed" />

            <!-- Il grafico delle ultime 24 ore -->
            <StackPanel x:Name="ParteGrafico">
                <Border x:Name="Linea2" Height="1" Margin="0,10,0,12" />
                <TextBlock x:Name="TitoloGrafico" Text="Ultime 24 ore" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                <WrapPanel x:Name="SceltaGrafico" Margin="0,0,0,10" />
                <Canvas x:Name="Grafico" Width="280" Height="98" HorizontalAlignment="Left" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
