<Window x:Class="BatterieInBarra.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BatterieInBarra"
        Title="Batterie"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <!-- La scheda con gli angoli arrotondati -->
    <Border x:Name="Scheda" Margin="10" CornerRadius="22" BorderThickness="1" Padding="20,18,20,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" />
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="Titolo" Text="{local:Testo batterie}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14" />

            <!-- I cerchi in alto -->
            <UniformGrid x:Name="Cerchi" Rows="1" />

            <Border x:Name="Linea1" Height="1" Margin="0,16,0,6" />

            <!-- La lista con nome, tempo stimato, percentuale e mini batteria -->
            <StackPanel x:Name="Lista" />

            <!-- Messaggio se non c'è nessun dispositivo -->
            <TextBlock x:Name="Vuoto" Text="{local:Testo nessun_collegato}" FontSize="13" Margin="0,8,0,0" Visibility="Collapsed" />

            <!-- Grafico (24 ore o 7 giorni) e statistiche -->
            <StackPanel x:Name="ParteGrafico">
                <Border x:Name="Linea2" Height="1" Margin="0,10,0,12" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitoloGrafico" Text="{local:Testo cronologia}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <!-- 24 ore / 7 giorni -->
                    <StackPanel x:Name="ScegliPeriodo" Grid.Column="1" Orientation="Horizontal" />
                </Grid>

                <!-- Bottoni per scegliere il dispositivo -->
                <WrapPanel x:Name="SceltaGrafico" Margin="0,0,0,10" />

                <Canvas x:Name="Grafico" Width="280" Height="98" HorizontalAlignment="Left" />

                <!-- Statistiche del dispositivo scelto -->
                <StackPanel x:Name="ParteStatistiche" Margin="0,12,0,0">
                    <TextBlock x:Name="TestoDurata" FontSize="12" />
                    <TextBlock x:Name="TestoCariche" FontSize="12" Margin="0,2,0,0" />
                    <TextBlock x:Name="TestoSalute" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Text="{local:Testo salute}" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
