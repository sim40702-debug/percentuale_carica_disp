<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- App Windows con finestre (WPF), senza console -->
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>

    <!-- .NET 10 con le funzioni di Windows 10/11 (batterie, notifiche) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>

    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <AssemblyName>BatterieInBarra</AssemblyName>
    <RootNamespace>BatterieInBarra</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- L'icona del file .exe (Esplora file, desktop, menu Start) -->
    <ApplicationIcon>Risorse\icona.ico</ApplicationIcon>

    <!-- Informazioni dell'app (la versione vera la mette GitHub dal tag) -->
    <Version>0.3.3</Version>
    <Product>Batterie in Barra</Product>
    <Authors>Simone</Authors>
    <Description>Mini batterie per i dispositivi Bluetooth sulla barra di Windows</Description>
  </PropertyGroup>

  <!-- I test stanno nella cartella Test: non fanno parte dell'app -->
  <ItemGroup>
    <Compile Remove="Test\**" />
    <Page Remove="Test\**" />
    <None Remove="Test\**" />
    <EmbeddedResource Remove="Test\**" />
  </ItemGroup>

  <!-- L'icona dentro l'app: per le finestre e per le notifiche -->
  <ItemGroup>
    <Resource Include="Risorse\icona.ico" />
    <Resource Include="Risorse\icona.png" />
  </ItemGroup>

</Project>
